{
  "expo": {
    "name": "Tradechu",
    "slug": "tradechu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tradechu",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tradechu.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan Pokémon cards for your binder.",
        "NSPhotoLibraryUsageDescription": "Choose card photos from your library.",
        "NSLocationWhenInUseUsageDescription": "Find nearby events and check in within 1 mile of the venue."
      }
    },
    "android": {
      "package": "com.tradechu.app",
      "adaptiveIcon": {
        "backgroundColor": "#fbf9f8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fbf9f8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tradechu to scan Pokémon cards."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tradechu to find nearby events and check you in."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
